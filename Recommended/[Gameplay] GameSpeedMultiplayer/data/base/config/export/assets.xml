<ModOps>
  <!-- Serp guids 1500000050 to 1500000055 -->
  
  <!-- GameClock:IncreaseGameSpeed() (does not work anymore when slowest speed reached -.-, same bug in Anno 1800 and 117 ...) -->
  <!-- GameClock:DecreaseGameSpeed() -->
  
  
  <!-- Code by Serp: -->
  <!-- Keybind Commands are only executed for the player who hit the button, which is most of the time exactly what we want. -->
  <!-- But when changing the game speed in multiplayer, it must be executed for all players. -->
  <!-- "ActionExecuteScript" does execute a script for all players at the same time, regardless which player triggered this action. -->
  <!-- Although this is something we usually DONT want, in this case it is the solution for the multiplayer gamespeed. -->
  
  <!-- alternative: -->
  <!-- GameClock:SetGameSpeed(4). only 2,3 and 4 are working it seems -->
  <!-- Easiest way to excute a lua script for all human participants at once, is to simply do ActionExecuteScript within a Trigger. -->
  <!-- Problem in Anno 117 is, that these scripts can not save any global/reusable variables and also can not access any variables from other scripts or their previous call..(was possible in 1800..) -->
  <!-- That means we are unable to save the current gamespeed in lua. Easiest workaround would be to simply define 4 different keybinds to access all allowed  gamespeeds. -->
   
  <!-- I added NotificationAudioAsset to the Notifications, dont ask me why they are still silent.. -->
  <!-- funktioniert weiterhin nur der erste keybind , wenn mehrere exakt denselben Command haben .. -->
  <ModOp Type="add" GUID='2001271' Path="/Values/ShortcutConfig/InputBindings">
    <Item>
      <Command>Conditions:RegisterTriggerForCurrentParticipantNet(1500000050)</Command>
      <Text>-6911597694545728808</Text>
      <Active>Session;WorldMap;Menu;Pause;Popup</Active>
      <AvailableOnPlatforms>PC;Xbox;PS;Stadia</AvailableOnPlatforms>
      <AudioEvent>125726</AudioEvent>
      <Configurable>1</Configurable>
      <HideInOptionMenu>0</HideInOptionMenu>
      <AllowMultipleShortcuts>1</AllowMultipleShortcuts>
      <InputTypes>
        <Modern>
          <KeyType>NumpadSubtract</KeyType>
        </Modern>
        <Legacy>
          <KeyType>NumpadSubtract</KeyType>
        </Legacy>
      </InputTypes>
    </Item>
