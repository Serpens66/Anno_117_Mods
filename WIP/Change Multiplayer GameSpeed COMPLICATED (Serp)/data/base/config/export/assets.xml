  <!-- Serp guids 1500000050 to 1500000054 -->

  <!-- GameClock:IncreaseGameSpeed() (does not work anymore when slowest speed reached -.-, same bug in Anno 1800 and 117 ...) -->
	<!-- GameClock:DecreaseGameSpeed() -->

  <!-- alternative: -->
  <!-- GameClock:SetGameSpeed(4). only 2,3 and 4 are working it seems -->
	
  <!-- Easiest way to excute a lua script for all human participants at once, is to simply do ActionExecuteScript within a Trigger. -->
  <!-- Problem in Anno 117 is, that these scripts can not save any global/reusable variables and also can not access any variables from other scripts or their previous call..(was possible in 1800..) -->
  <!-- That means we are unable to save the current gamespeed in lua. Easiest workaround would be to simply define 4 different keybinds to access all allowed  -->
   <!-- gamespeeds. But I want it to make with only 2 keybinds (descrease/increase), so I will implement a complicated solution :D -->
    <!-- I will make use of xml Variables and the fact that Tick-lua scripts are able to remember their lua variables. -->
  
  <!-- I added NotificationAudioAsset to the Notifications, dont ask me why they are still silent.. -->
  
  <!-- Variablen können frei erstellt werden ohne Enum und können mit konstanten oder auch mit anderen Variablen in Condition verglichen werden -->
  <!-- Sie können statt in der Config, auch in einer StorylineVariables definiert werden -->
  <!-- Aber scheinbar kann man sie nicht direkt auf einen wert wie "Anzahl der Häuser" oderso setzen oder damit vergleichen.. -->
  <!-- Doch es gibt immerhin ActionSetVariable mit SetIntVariableToRandom/SetAssetVariableToRandomPoolEntry/SetIntVariableByProgressLevel -->
    <!-- gibt an sich auch SetIntVariableToSpecialValue, aber natürlich gibts da nur die Option BailoutMoneyAmount :D -->
   <!-- für +- gibt es ActionModifyVariable und um fixen wert zu setzen muss man Random zwischen 1 und 1 machen, ums auf 1 zu setzen -->
  <!-- kann in lua mit Variables:GetVariable("SerpTestInt") abgefragt werden (aber leider nicht gesetzt..) -->
  <!-- mit ConditionCompareVariable kann man ihren wert in xml abgleichen -->
  <!-- Eine normale Variable gilt pro Participant! und wird im Coop dann auch entrechend gesynced. -->
  <!-- Es gibt aber auch Multiplayervariablen, in GUID 145949 , aber einfach nur da zufügen teilt sie offenbar nicht mit anderen Participants.. also keine Ahnung wie nutzen -->
  <ModOp Type="add" GUID='145949' Path="/Values/ConditionVariableConfiguration/IntVariables">
    <Item>
      <Name>CurrentGameSpeed_MP_Serp</Name>
      <StartValue>2</StartValue>
      <Comment>Usage in MP Game Speed Mod</Comment>
    </Item>
  </ModOp>
  
  
  <!-- funktioniert weiterhin nur der erste keybind , wenn mehrere exakt denselben Command haben .. -->
