  <!-- Code by Serp: -->
  <!-- Keybind Commands are only executed for the player who hit the button, which is most of the time exactly what we want. -->
  <!-- But when changing the game speed in multiplayer, it must be executed for all players. -->
  <!-- "ActionExecuteScript" does execute a script for all players at the same time, regardless which player triggered this action. -->
  <!-- Although this is something we usually DONT want, in this case it is the solution for the multiplayer gamespeed. -->
  
  <ModOp GUID="87295" Type="AddNextSibling">
    
    <Asset>
      <Template>Trigger</Template>
      <Values>
        <Standard>
          <Name>Decrease Speed MP</Name>
          <GUID>1500000050</GUID>
        </Standard>
        <Trigger>
          <!-- <TriggerCondition> -->
            <!-- <Template>ConditionIsMultiplayer</Template> -->
            <!-- <Values> -->
              <!-- <Condition> -->
                <!-- <SubConditionCompletionOrder>MutuallyExclusive</SubConditionCompletionOrder> -->
              <!-- </Condition> -->
              <!-- <ConditionIsMultiplayer> -->
                <!-- <MultiplayerMode>Singleplayer</MultiplayerMode> -->
              <!-- </ConditionIsMultiplayer> -->
              <!-- <ConditionPropsNegatable> -->
                <!-- <NegateCondition>1</NegateCondition> -->
              <!-- </ConditionPropsNegatable> -->
            <!-- </Values> -->
          <!-- </TriggerCondition> -->
          <TriggerCondition>
            <Template>ConditionAlwaysTrue</Template>
            <Values>
              <Condition>
                <SubConditionCompletionOrder>MutuallyExclusive</SubConditionCompletionOrder>
              </Condition>
              <ConditionAlwaysTrue />
            </Values>
          </TriggerCondition>
          <!-- Only decrease the value of "CurrentGameSpeed_MP_Serp" by one, if it is MoreThan 2 (because 2 is the min allowed gamespeed) -->
          <SubTriggers>
            <Item>
              <SubTrigger>
                <Template>AutoCreateTrigger</Template>
                <Values>
                  <Trigger>
                    <TriggerCondition>
                      <Template>ConditionCompareVariable</Template>
                      <Values>
                        <Condition/>
                        <ConditionCompareVariable>
                          <VariableToCheck>CurrentGameSpeed_MP_Serp</VariableToCheck>
                          <ComparisonOperation>MoreThan</ComparisonOperation>
                          <SecondVariable>
                            <Template>IntVariableOrValue</Template>
                            <Values>
                              <IntVariableOrValue>
                                <IntValue>2</IntValue>
                              </IntVariableOrValue>
                            </Values>
                          </SecondVariable>
                        </ConditionCompareVariable>
                      </Values>
                    </TriggerCondition>
                    <TriggerActions>
                      <Item>
                        <TriggerAction>
                          <Template>ActionModifyVariable</Template>
                          <Values>
                            <Action/>
                            <ActionModifyVariable>
                              <VariableName>CurrentGameSpeed_MP_Serp</VariableName>
                              <Modifier>Subtract</Modifier>
                              <ModifierVariable>
                                <Template>IntVariableOrValue</Template>
                                <Values>
                                  <IntVariableOrValue>
                                    <IntValue>1</IntValue>
                                  </IntVariableOrValue>
                                </Values>
                              </ModifierVariable>
                            </ActionModifyVariable>
                          </Values>
                        </TriggerAction>
                      </Item>
                      <Item>
                        <TriggerAction>
                          <Template>ActionNotification</Template>
                          <Values>
                            <Action />
                            <ActionNotification>
                              <Notification>
                                <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                                <Values>
                                  <SideNotification>
                                    <IconAsset>501356</IconAsset>
                                    <NotificationSideTitle>-6902842790310563938</NotificationSideTitle>
                                    <HasJumpLocation>0</HasJumpLocation>
                                    <IsArchivable>0</IsArchivable>
                                  </SideNotification>
                                  <BaseNotification>
                                    <NotificationText>-6911597694545728808</NotificationText>
                                    <NotificationAudioAsset>125726</NotificationAudioAsset>
                                    <NotificationPriority>-1</NotificationPriority>
                                    <NotificationTopic>OnlineGame</NotificationTopic>
                                  </BaseNotification>
                                  <NotificationSubtitle>
                                    <Subtitle>-6911597694545728808</Subtitle>
                                  </NotificationSubtitle>
                                </Values>
                              </Notification>
                            </ActionNotification>
                          </Values>
                        </TriggerAction>
                      </Item>
                    </TriggerActions>
                  </Trigger>
                </Values>
              </SubTrigger>
            </Item>
            <Item>
              <SubTrigger>
                <Template>AutoCreateTrigger</Template>
                <Values>
                  <Trigger>
                    <TriggerCondition>
                      <Template>ConditionCompareVariable</Template>
                      <Values>
                        <Condition/>
                        <ConditionCompareVariable>
                          <VariableToCheck>CurrentGameSpeed_MP_Serp</VariableToCheck>
                          <ComparisonOperation>AtMost</ComparisonOperation>
                          <SecondVariable>
                            <Template>IntVariableOrValue</Template>
                            <Values>
                              <IntVariableOrValue>
                                <IntValue>2</IntValue>
                              </IntVariableOrValue>
                            </Values>
                          </SecondVariable>
                        </ConditionCompareVariable>
                      </Values>
                    </TriggerCondition>
                  </Trigger>
                </Values>
              </SubTrigger>
            </Item>
          </SubTriggers>
        </Trigger>
        <TriggerSetup>
          <AutoRegisterTrigger>0</AutoRegisterTrigger>
          <UsedBySecondParties>0</UsedBySecondParties>
        </TriggerSetup>
      </Values>
    </Asset>
    
    
    <Asset>
      <Template>Trigger</Template>
      <Values>
        <Standard>
          <Name>Increase Speed MP</Name>
          <GUID>1500000051</GUID>
        </Standard>
        <Trigger>
          <!-- <TriggerCondition> -->
            <!-- <Template>ConditionIsMultiplayer</Template> -->
            <!-- <Values> -->
              <!-- <Condition> -->
                <!-- <SubConditionCompletionOrder>MutuallyExclusive</SubConditionCompletionOrder> -->
              <!-- </Condition> -->
              <!-- <ConditionIsMultiplayer> -->
                <!-- <MultiplayerMode>Singleplayer</MultiplayerMode> -->
              <!-- </ConditionIsMultiplayer> -->
              <!-- <ConditionPropsNegatable> -->
                <!-- <NegateCondition>1</NegateCondition> -->
              <!-- </ConditionPropsNegatable> -->
            <!-- </Values> -->
          <!-- </TriggerCondition> -->
          <TriggerCondition>
            <Template>ConditionAlwaysTrue</Template>
            <Values>
              <Condition>
                <SubConditionCompletionOrder>MutuallyExclusive</SubConditionCompletionOrder>
              </Condition>
              <ConditionAlwaysTrue />
            </Values>
          </TriggerCondition>
          <!-- Only increase the value of "CurrentGameSpeed_MP_Serp" by one, if it is LessThan 4 (because 4 is the max allowed gamespeed) -->
          <SubTriggers>
            <Item>
              <SubTrigger>
                <Template>AutoCreateTrigger</Template>
                <Values>
                  <Trigger>
                    <TriggerCondition>
                      <Template>ConditionCompareVariable</Template>
                      <Values>
                        <Condition/>
                        <ConditionCompareVariable>
                          <VariableToCheck>CurrentGameSpeed_MP_Serp</VariableToCheck>
                          <ComparisonOperation>LessThan</ComparisonOperation>
                          <SecondVariable>
                            <Template>IntVariableOrValue</Template>
                            <Values>
                              <IntVariableOrValue>
                                <IntValue>4</IntValue>
                              </IntVariableOrValue>
                            </Values>
                          </SecondVariable>
                        </ConditionCompareVariable>
                      </Values>
                    </TriggerCondition>
                    <TriggerActions>
                      <Item>
                        <TriggerAction>
                          <Template>ActionModifyVariable</Template>
                          <Values>
                            <Action/>
                            <ActionModifyVariable>
                              <VariableName>CurrentGameSpeed_MP_Serp</VariableName>
                              <Modifier>Add</Modifier>
                              <ModifierVariable>
                                <Template>IntVariableOrValue</Template>
                                <Values>
                                  <IntVariableOrValue>
                                    <IntValue>1</IntValue>
                                  </IntVariableOrValue>
                                </Values>
                              </ModifierVariable>
                            </ActionModifyVariable>
                          </Values>
                        </TriggerAction>
                      </Item>
                      <Item>
                        <TriggerAction>
                          <Template>ActionNotification</Template>
                          <Values>
                            <Action />
                            <ActionNotification>
                              <Notification>
                                <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                                <Values>
                                  <SideNotification>
                                    <IconAsset>501356</IconAsset>
                                    <NotificationSideTitle>-6902842790310563938</NotificationSideTitle>
                                    <HasJumpLocation>0</HasJumpLocation>
                                    <IsArchivable>0</IsArchivable>
                                  </SideNotification>
                                  <BaseNotification>
                                    <NotificationText>-6903066501330432418</NotificationText>
                                    <NotificationAudioAsset>125725</NotificationAudioAsset>
                                    <NotificationPriority>-1</NotificationPriority>
                                    <NotificationTopic>OnlineGame</NotificationTopic>
                                  </BaseNotification>
                                  <NotificationSubtitle>
                                    <Subtitle>-6903066501330432418</Subtitle>
                                  </NotificationSubtitle>
                                </Values>
                              </Notification>
                            </ActionNotification>
                          </Values>
                        </TriggerAction>
                      </Item>
                    </TriggerActions>
                  </Trigger>
                </Values>
              </SubTrigger>
            </Item>
            <Item>
              <SubTrigger>
                <Template>AutoCreateTrigger</Template>
                <Values>
                  <Trigger>
                    <TriggerCondition>
                      <Template>ConditionCompareVariable</Template>
                      <Values>
                        <Condition/>
                        <ConditionCompareVariable>
                          <VariableToCheck>CurrentGameSpeed_MP_Serp</VariableToCheck>
                          <ComparisonOperation>AtLeast</ComparisonOperation>
                          <SecondVariable>
                            <Template>IntVariableOrValue</Template>
                            <Values>
                              <IntVariableOrValue>
                                <IntValue>4</IntValue>
                              </IntVariableOrValue>
                            </Values>
                          </SecondVariable>
                        </ConditionCompareVariable>
                      </Values>
                    </TriggerCondition>
                  </Trigger>
                </Values>
              </SubTrigger>
            </Item>
          </SubTriggers>
        </Trigger>
        <TriggerSetup>
          <AutoRegisterTrigger>0</AutoRegisterTrigger>
          <UsedBySecondParties>0</UsedBySecondParties>
        </TriggerSetup>
      </Values>
    </Asset>
    
    <Asset>
      <Template>Trigger</Template>
      <Values>
        <Standard>
          <Name>Reset Variable (eg. when leaving pause menu or load a save), registered via lua</Name>
          <GUID>1500000054</GUID>
        </Standard>
        <Trigger>
          <TriggerCondition>
            <Template>ConditionAlwaysTrue</Template>
            <Values>
              <Condition/>
              <ConditionAlwaysTrue/>
            </Values>
          </TriggerCondition>
          <TriggerActions>
            <Item>
              <TriggerAction>
                <Template>ActionSetVariable</Template>
                <Values>
                  <Action/>
                  <ActionSetVariable>
                    <VariableName>CurrentGameSpeed_MP_Serp</VariableName>
                    <SetVariableTo>
                      <Template>SetIntVariableToRandom</Template>
                      <Values>
                        <SetIntVariableToRandom>
                          <Min>2</Min>
                          <Max>2</Max>
                        </SetIntVariableToRandom>
                      </Values>
                    </SetVariableTo>
                  </ActionSetVariable>
                </Values>
              </TriggerAction>
            </Item>
          </TriggerActions>
        </Trigger>
        <TriggerSetup>
          <AutoRegisterTrigger>0</AutoRegisterTrigger>
          <UsedBySecondParties>0</UsedBySecondParties>
        </TriggerSetup>
      </Values>
    </Asset>
    
    
  </ModOp>

</ModOps> 